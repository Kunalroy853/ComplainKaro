# Environment variables for Hostel Complaint Triage System - Backend

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/vocallabs

# ─── JWT Auth ────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars
JWT_EXPIRY=7d

# ─── Google Gemini AI ────────────────────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash-exp
GEMINI_EMBEDDING_MODEL=text-embedding-004
# Timeout in milliseconds for Gemini API calls
GEMINI_TIMEOUT_MS=8000

# ─── Whisper.cpp (Speech-to-Text) ────────────────────────────────────────────
# Path to whisper.cpp main binary (e.g. C:\tools\whisper.cpp\main.exe on Windows)
# Download from: https://github.com/ggerganov/whisper.cpp/releases
WHISPER_BINARY_PATH=whisper
# Path to the GGML model file (e.g. C:\tools\whisper.cpp\models\ggml-base.bin)
# Download: cd whisper.cpp && bash ./models/download-ggml-model.sh base
WHISPER_MODEL_PATH=./models/ggml-base.bin
# Language hint for transcription (auto-detect if omitted)
WHISPER_LANGUAGE=auto

# ─── Cloudinary (Audio Storage) ──────────────────────────────────────────────
# Leave all three blank to use local disk storage instead (uploads/ folder)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── App Config ──────────────────────────────────────────────────────────────
PORT=4000
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# ─── Dedup Thresholds ────────────────────────────────────────────────────────
# Cosine similarity threshold above which tickets are considered duplicates (0-1)
DEDUP_SIMILARITY_THRESHOLD=0.85
# Rolling window in hours for dedup search
DEDUP_WINDOW_HOURS=72

# ─── Classification ──────────────────────────────────────────────────────────
# Confidence score below which a ticket is flagged for manual warden review
MANUAL_REVIEW_THRESHOLD=0.6
